{
  "name": "gamerfolio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.11.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @gamerfolio/web dev",
    "dev:web": "pnpm --filter @gamerfolio/web dev",
    "dev:api": "pnpm --filter @gamerfolio/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @gamerfolio/web build",
    "build:api": "pnpm --filter @gamerfolio/api build",
    "start:web": "pnpm --filter @gamerfolio/web start",
    "start:api": "pnpm --filter @gamerfolio/api start",
    "lint": "pnpm -r lint"
  }
}
