# ─────────────────────────────────────────────
# GamerFolio Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV="development"

# PostgreSQL (Prisma connection string)
# Local example: postgresql://postgres:postgres@localhost:5432/gamerfolio
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE"

# Frontend origin allowed by CORS + used for redirects/links
FRONTEND_URL="https://YOUR-VERCEL-DOMAIN.vercel.app"

# Google Sign-In (used to verify the Google ID token sent by the frontend)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Application JWT
JWT_SECRET="YOUR_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"

# Game catalogue provider (IGDB via Twitch OAuth)
# https://api-docs.igdb.com/#getting-started
GAME_API_CLIENT_ID="YOUR_GAME_API_CLIENT_ID"
GAME_API_CLIENT_SECRET="YOUR_GAME_API_CLIENT_SECRET"
